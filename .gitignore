# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP config — contains API keys, never commit
.mcp.json

# local-only working notes — never commit
docs/gbp-*.md

# Blender auto-backups next to the sauna room source
*.blend1
*.blend2

# Canva project working notes
content/canva_plan.md

# Canva Connect API — OAuth tokens, never commit
.canva-tokens.json
# Cached Canva folder/design IDs — machine-local
.canva-state.json

# Canva render output (regenerate with: node scripts/canva/canva.mjs render)
scripts/canva/out/
